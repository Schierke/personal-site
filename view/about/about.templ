package about

import "github.com/Schierke/personal-site/view/layout"

templ Show() {
    @layout.Base() {
        <section id="about" class="mb-4">
            <h2 class="h3 font-weight-bold mb-3">About Me</h2>
            <p class="text-muted">I am a passionate individual who loves coding and creating websites.</p>
        </section>
    }
    
}
